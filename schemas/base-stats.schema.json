{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "familyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "ranks": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "spd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "ea": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "pa": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "ed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "pd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "hp",
          "spd",
          "ea",
          "pa",
          "ed",
          "pd"
        ],
        "additionalProperties": false
      },
      "provenance": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 200
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "maxLength": 200
          },
          "gameVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "retrievedOn",
          "method",
          "gameVerified"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "familyId",
      "ranks",
      "provenance"
    ],
    "additionalProperties": false
  }
}