{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "normalized": {
        "type": "string"
      },
      "familyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      }
    },
    "required": [
      "query",
      "normalized",
      "familyId"
    ],
    "additionalProperties": false
  }
}