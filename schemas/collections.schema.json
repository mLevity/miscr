{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miscrits:collections:v1",
  "title": "collections",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "sourceGroup": {
        "type": "string",
        "maxLength": 200
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "familyId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-z0-9][a-z0-9:_-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceName": {
              "type": "string",
              "maxLength": 200
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "formId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-z0-9][a-z0-9:_-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "levelConstraint": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 35
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "familyId",
            "sourceName",
            "quantity",
            "formId",
            "levelConstraint"
          ],
          "additionalProperties": false
        },
        "maxItems": 1000
      },
      "rewards": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "name": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "quantity",
            "name"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "claimPolicy": {
        "enum": [
          "manual-user-tracking"
        ]
      },
      "provenance": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 200
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "maxLength": 200
          },
          "gameVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "retrievedOn",
          "method",
          "gameVerified"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "sourceGroup",
      "requirements",
      "rewards",
      "claimPolicy",
      "provenance"
    ],
    "additionalProperties": false
  }
}
