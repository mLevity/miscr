{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miscrits:miscrit-abilities:v1",
  "title": "miscrit-abilities",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "familyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "abilityId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "order": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "unlockLevel": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 35
          },
          {
            "type": "null"
          }
        ]
      },
      "unlockLevelStatus": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "familyId",
      "abilityId",
      "order",
      "unlockLevel",
      "unlockLevelStatus"
    ],
    "additionalProperties": false
  }
}
