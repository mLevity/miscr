{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miscrits:locations:v1",
  "title": "locations",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "sortOrder": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      },
      "kind": {
        "enum": [
          "world",
          "shop"
        ]
      },
      "mapId": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z0-9][a-z0-9:_-]*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "provenance": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 200
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "maxLength": 200
          },
          "gameVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "retrievedOn",
          "method",
          "gameVerified"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "sortOrder",
      "kind",
      "mapId",
      "provenance"
    ],
    "additionalProperties": false
  }
}
