{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miscrits:spawns:v1",
  "title": "spawns",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "familyId": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z0-9][a-z0-9:_-]*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "sourceName": {
        "type": "string",
        "maxLength": 200
      },
      "locationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "areaId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "acquisition": {
        "enum": [
          "wild",
          "shop",
          "unknown"
        ]
      },
      "schedule": {
        "type": "object",
        "properties": {
          "timezone": {
            "enum": [
              "UTC"
            ]
          },
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "maxItems": 7,
            "uniqueItems": true
          },
          "rule": {
            "enum": [
              "weekly",
              "unknown"
            ]
          },
          "validFrom": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "validUntil": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedOn": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "timezone",
          "weekdays",
          "rule",
          "validFrom",
          "validUntil",
          "observedOn"
        ],
        "additionalProperties": false
      },
      "precision": {
        "enum": [
          "area",
          "point",
          "point-area-ambiguous"
        ]
      },
      "markerIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9:_-]*$"
        },
        "maxItems": 100
      },
      "sourceRarity": {
        "type": "string",
        "maxLength": 200
      },
      "sourceElement": {
        "type": "string",
        "maxLength": 200
      },
      "conditionsText": {
        "type": "string",
        "maxLength": 20000
      },
      "encounterProbability": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "provenance": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 200
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "maxLength": 200
          },
          "gameVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "retrievedOn",
          "method",
          "gameVerified"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "familyId",
      "sourceName",
      "locationId",
      "areaId",
      "acquisition",
      "schedule",
      "precision",
      "markerIds",
      "sourceRarity",
      "sourceElement",
      "conditionsText",
      "encounterProbability",
      "provenance"
    ],
    "additionalProperties": false
  }
}
