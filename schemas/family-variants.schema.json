{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "familyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "variant": {
        "enum": [
          "base",
          "dark",
          "light",
          "blighted",
          "foil"
        ]
      },
      "classificationMethod": {
        "type": "string"
      },
      "note": {
        "type": "string"
      }
    },
    "required": [
      "familyId",
      "variant",
      "classificationMethod",
      "note"
    ],
    "additionalProperties": false
  }
}