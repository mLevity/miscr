{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miscrits:maps:v1",
  "title": "maps",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "locationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "image": {
        "type": "string",
        "maxLength": 300
      },
      "width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "sourceWidth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "sourceHeight": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "sourceUrl": {
        "type": "string",
        "maxLength": 1000
      },
      "captureMethod": {
        "type": "string",
        "maxLength": 200
      },
      "quality": {
        "type": "string",
        "maxLength": 200
      },
      "coordinateSystem": {
        "enum": [
          "normalized-0-1-top-left"
        ]
      },
      "provenance": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 200
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "maxLength": 200
          },
          "gameVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceId",
          "retrievedOn",
          "method",
          "gameVerified"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "locationId",
      "image",
      "width",
      "height",
      "sourceWidth",
      "sourceHeight",
      "sourceUrl",
      "captureMethod",
      "quality",
      "coordinateSystem",
      "provenance"
    ],
    "additionalProperties": false
  }
}
