{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miscrits:areas:v1",
  "title": "areas",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "locationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z0-9][a-z0-9:_-]*$"
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "sortOrder": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      },
      "polygon": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxItems": 2
            },
            "maxItems": 1000
          },
          {
            "type": "null"
          }
        ]
      },
      "geometryStatus": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "id",
      "locationId",
      "name",
      "sortOrder",
      "polygon",
      "geometryStatus"
    ],
    "additionalProperties": false
  }
}
